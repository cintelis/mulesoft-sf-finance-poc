  <!-- ===================== payments ===================== -->

  <munit:test name="apply-payment-applied-returns-201" description="An applied payment gives 201 and typed procedure parameters">
    <munit:behavior>
      <munit-tools:mock-when processor="db:stored-procedure" doc:name="Mock apply_payment">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Call apply_payment"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[{ p_result: 'APPLIED', p_invoice_status: 'PAID' }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <munit:set-event>
        <munit:payload mediaType="application/json"
                       value="#[output application/json --- { paymentRef: 'PAY-20261116-0001', invoiceNumber: 'INV-100002', amount: 1375.00, paymentDate: '2026-11-16', method: 'EFT', payerName: 'Harbour City Plumbing' }]"/>
      </munit:set-event>
      <flow-ref name="post:\payments:application\json:finance-sys-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
      <munit-tools:assert-that expression="#[payload.result]" is="#[MunitTools::equalTo('APPLIED')]"/>
      <munit-tools:assert-that expression="#[payload.invoiceStatus]" is="#[MunitTools::equalTo('PAID')]"/>
      <munit-tools:assert-that expression="#[payload.paymentRef]" is="#[MunitTools::equalTo('PAY-20261116-0001')]"/>
      <munit-tools:assert-that expression="#[vars.params.p_currency_code]" is="#[MunitTools::equalTo('AUD')]"/>
      <munit-tools:assert-that expression="#[vars.params.p_payment_date as String]" is="#[MunitTools::equalTo('2026-11-16')]"/>
      <munit-tools:assert-that expression="#[vars.params.p_amount]" is="#[MunitTools::equalTo(1375)]"/>
    </munit:validation>
  </munit:test>

