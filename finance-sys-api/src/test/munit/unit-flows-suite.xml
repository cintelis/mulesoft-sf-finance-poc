        <munit-tools:then-return>
          <munit-tools:payload value="#[{ p_result: 'DUPLICATE', p_invoice_status: 'PAID' }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <munit:set-event>
        <munit:payload mediaType="application/json"
                       value="#[output application/json --- { paymentRef: 'PAY-20261116-0001', invoiceNumber: 'INV-100002', amount: 1375.00, currency: 'AUD', paymentDate: '2026-11-16', method: 'EFT' }]"/>
      </munit:set-event>
      <flow-ref name="post:\payments:application\json:finance-sys-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(200)]"/>
      <munit-tools:assert-that expression="#[payload.result]" is="#[MunitTools::equalTo('DUPLICATE')]"/>
    </munit:validation>
  </munit:test>

  <!-- ===================== support ===================== -->

  <munit:test name="health-up" description="Database reachable gives UP">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select" doc:name="Mock ping">
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{ OK: 1 }]]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\health:finance-sys-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('UP')]"/>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::nullValue()]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="health-down-returns-503" description="Database unreachable gives 503 DOWN instead of an error">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select" doc:name="Mock ping failure">
        <munit-tools:then-return>
          <munit-tools:error typeId="DB:CONNECTIVITY"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\health:finance-sys-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.database]" is="#[MunitTools::equalTo('DOWN')]"/>
      <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(503)]"/>
    </munit:validation>
  </munit:test>

  <munit:test name="recon-maps-hashes" description="Reconciliation rows are renamed to the API contract">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select" doc:name="Mock recon">
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{ SF_ACCOUNT_ID: '001Qy00000AbCdEIAV', CUSTOMER_CODE: 'C001001', ROW_HASH: 'abc123' }]]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\recon\customers:finance-sys-api-config"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.count]" is="#[MunitTools::equalTo(1)]"/>
      <munit-tools:assert-that expression="#[payload.items[0].rowHash]" is="#[MunitTools::equalTo('abc123')]"/>
      <munit-tools:assert-that expression="#[payload.items[0].sfAccountId]" is="#[MunitTools::equalTo('001Qy00000AbCdEIAV')]"/>
    </munit:validation>
  </munit:test>

