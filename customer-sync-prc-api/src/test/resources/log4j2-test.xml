<?xml version="1.0" encoding="UTF-8"?>
<!-- Console-only logging for MUnit runs (there is no mule.home to write files to). -->
<Configuration>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="%-5p %d{HH:mm:ss.SSS} [%X{correlationId}] %c{1}: %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <AsyncLogger name="org.mule.service.http" level="WARN"/>
    <AsyncLogger name="org.mule.extension.http" level="WARN"/>
    <AsyncRoot level="INFO">
      <AppenderRef ref="console"/>
    </AsyncRoot>
  </Loggers>
</Configuration>
