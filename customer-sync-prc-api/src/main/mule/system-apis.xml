<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- One way to call each system API, used by every flow.

       In:  vars.req     { method, path, query }
            vars.reqBody  JSON body, or null
       Out: vars.res     { status, body }

       Retry rule: a 5xx response or a connection failure is retried (Until
       Successful). A 4xx response is returned to the caller without a retry,
       because bad data will not succeed the second time. The correlation ID
       travels with every call. -->

  <sub-flow name="call-finance" doc:name="call-finance">
    <until-successful maxRetries="${retry.max}" millisBetweenRetries="${retry.waitMillis}" doc:name="Retry transient failures">
      <http:request config-ref="finance-api" method="#[vars.req.method]" path="#[vars.req.path]"
                    target="res" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]" doc:name="Finance system API">
        <http:body>#[vars.reqBody]</http:body>
        <http:headers>#[{ 'X-Correlation-ID': correlationId, ('Content-Type': 'application/json') if (vars.reqBody != null) }]</http:headers>
        <http:query-params>#[vars.req.query default {}]</http:query-params>
        <http:response-validator>
          <http:success-status-code-validator values="200..499"/>
        </http:response-validator>
      </http:request>
    </until-successful>
  </sub-flow>

  <sub-flow name="call-sfdc" doc:name="call-sfdc">
    <until-successful maxRetries="${retry.max}" millisBetweenRetries="${retry.waitMillis}" doc:name="Retry transient failures">
      <http:request config-ref="sfdc-api" method="#[vars.req.method]" path="#[vars.req.path]"
                    target="res" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]" doc:name="Salesforce system API">
        <http:body>#[vars.reqBody]</http:body>
        <http:headers>#[{ 'X-Correlation-ID': correlationId, ('Content-Type': 'application/json') if (vars.reqBody != null) }]</http:headers>
        <http:query-params>#[vars.req.query default {}]</http:query-params>
        <http:response-validator>
          <http:success-status-code-validator values="200..499"/>
        </http:response-validator>
      </http:request>
    </until-successful>
  </sub-flow>

  <!-- Records the payload as the last run of vars.statusKey. -->
  <sub-flow name="record-status" doc:name="record-status">
    <os:store key="#[vars.statusKey]" objectStore="status-store" doc:name="Store last run">
      <os:value>#[output application/java --- write(payload, 'application/json')]</os:value>
    </os:store>
    <!-- Keep a history too, newest first. Routine runs that found nothing (the
         scheduled sync, or the sync that follows a payments file) are left out
         so they do not bury the runs that did something. -->
    <choice doc:name="Worth keeping in history?">
      <when expression="#[output application/java --- not (vars.statusKey == 'invoiceSync' and (payload.trigger default 'request') != 'request' and (payload.invoicesRead default 0) == 0)]">
        <os:retrieve key="history" objectStore="status-store" target="historyJson" doc:name="Read history">
          <os:default-value>#['[]']</os:default-value>
        </os:retrieve>
        <ee:transform doc:name="Add this run">
          <ee:variables>
            <ee:set-variable variableName="newHistory"><![CDATA[%dw 2.0
import take from dw::core::Arrays
output application/java
var entry = {
  flow: vars.statusKey,
  recordedAt: now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"},
  correlationId: correlationId,
  run: payload
}
---
write(take([entry] ++ read(vars.historyJson as String, "application/json"), 50), "application/json")]]></ee:set-variable>
          </ee:variables>
        </ee:transform>
        <os:store key="history" objectStore="status-store" doc:name="Store history">
          <os:value>#[vars.newHistory]</os:value>
        </os:store>
      </when>
    </choice>
  </sub-flow>
</mule>
